{
  "name": "@moteurio/design",
  "version": "0.1.0",
  "description": "Moteur's design system: the Discothèque and Folio looks as CSS variables, fonts, motion tokens and moments",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./js/tokens.d.ts",
      "default": "./js/tokens.js"
    },
    "./discotheque.css": "./css/discotheque.css",
    "./folio.css": "./css/folio.css",
    "./looks.css": "./css/looks.css",
    "./moments.css": "./css/moments.css",
    "./fonts/discotheque.css": "./css/fonts/discotheque.css",
    "./fonts/folio.css": "./css/fonts/folio.css",
    "./tokens/*.json": "./tokens/*.json",
    "./motion": {
      "types": "./js/motion.d.ts",
      "default": "./js/motion.js"
    },
    "./contrast": {
      "types": "./scripts/contrast.d.ts",
      "default": "./scripts/contrast.mjs"
    },
    "./stylelint": "./stylelint/index.js",
    "./vscode/css-custom-data.json": "./vscode/css-custom-data.json",
    "./vscode/html-custom-data.json": "./vscode/html-custom-data.json",
    "./docs/*": "./docs/*"
  },
  "files": [
    "css",
    "js",
    "tokens",
    "docs",
    "scripts/contrast.mjs",
    "scripts/contrast.d.ts",
    "stylelint",
    "vscode",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && stylelint css/moments.css",
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "stylelint": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0",
    "@fontsource/bagel-fat-one": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/shrikhand": "^5.3.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "playwright-core": "1.57.0",
    "stylelint": "^17.16.0"
  },
  "license": "MIT"
}
